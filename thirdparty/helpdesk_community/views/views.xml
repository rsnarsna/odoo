<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_helpdesk_support_desk_form" model="ir.ui.view">
        <field name="name">helpdesk.support.desk.form</field>
        <field name="model">helpdesk.support.desk</field>
        <field name="arch" type="xml">
            <form string="Community Support Ticket Desk">
                <header>

                    <button name="action_resolve" string="Mark Resolved" type="object" class="oe_highlight" invisible="stage in ('resolved', 'closed')"/>
                    <button name="action_close" string="Close Ticket" type="object" invisible="stage != 'resolved'"/>
                    <field name="stage" widget="statusbar" statusbar_visible="new,in_progress,waiting,resolved,closed"/>

                </header>
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="E.g. Unable to print invoice PDF"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ticket_id"/>
                            <field name="partner_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="desc">
                            <field name="description" placeholder="Customer issue description..."/>
                        </page>
                        <page string="Resolution" name="res">
                            <field name="resolution_notes" placeholder="Steps taken to resolve ticket..."/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_helpdesk_support_desk_list" model="ir.ui.view">
        <field name="name">helpdesk.support.desk.list</field>
        <field name="model">helpdesk.support.desk</field>
        <field name="arch" type="xml">
            <list string="Community Support Ticket Desk">

                <field name="ticket_id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="assigned_user_id"/>
                <field name="priority" widget="priority"/>
                <field name="stage" widget="badge"/>

            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_helpdesk_support_desk_search" model="ir.ui.view">
        <field name="name">helpdesk.support.desk.search</field>
        <field name="model">helpdesk.support.desk</field>
        <field name="arch" type="xml">
            <search string="Community Support Ticket Desk">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_helpdesk_support_desk" model="ir.actions.act_window">
        <field name="name">Community Support Ticket Desk</field>
        <field name="res_model">helpdesk.support.desk</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Community Support Ticket Desk entry!
            </p>
        </field>
    </record>

    <!-- Top-level and Action Menu -->
    <menuitem id="menu_helpdesk_support_desk_root" 
              name="Community Support Ticket Desk" 
              sequence="50"/>

    <menuitem id="menu_helpdesk_support_desk_main" 
              name="Community Support Ticket Desk" 
              parent="menu_helpdesk_support_desk_root" 
              action="action_helpdesk_support_desk" 
              sequence="10"/>
</odoo>
