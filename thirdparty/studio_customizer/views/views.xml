<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_studio_lowcode_field_form" model="ir.ui.view">
        <field name="name">studio.lowcode.field.form</field>
        <field name="model">studio.lowcode.field</field>
        <field name="arch" type="xml">
            <form string="Community Studio Low-Code Builder">
                <header>

                    <button name="action_activate" string="Deploy to Model" type="object" class="oe_highlight" invisible="state == 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>

                </header>
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="x_customer_vat_reference"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="label"/>
                            <field name="model_id"/>
                        </group>
                        <group>
                            <field name="field_type"/>
                            <field name="is_required"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documentation" name="doc">
                            <field name="notes" placeholder="Why this field was created..."/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_studio_lowcode_field_list" model="ir.ui.view">
        <field name="name">studio.lowcode.field.list</field>
        <field name="model">studio.lowcode.field</field>
        <field name="arch" type="xml">
            <list string="Community Studio Low-Code Builder">

                <field name="name"/>
                <field name="label"/>
                <field name="model_id"/>
                <field name="field_type"/>
                <field name="is_required"/>
                <field name="state" widget="badge"/>

            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_studio_lowcode_field_search" model="ir.ui.view">
        <field name="name">studio.lowcode.field.search</field>
        <field name="model">studio.lowcode.field</field>
        <field name="arch" type="xml">
            <search string="Community Studio Low-Code Builder">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_studio_lowcode_field" model="ir.actions.act_window">
        <field name="name">Community Studio Low-Code Builder</field>
        <field name="res_model">studio.lowcode.field</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Community Studio Low-Code Builder entry!
            </p>
        </field>
    </record>

    <!-- Top-level and Action Menu -->
    <menuitem id="menu_studio_lowcode_field_root" 
              name="Community Studio Low-Code Builder" 
              sequence="50"/>

    <menuitem id="menu_studio_lowcode_field_main" 
              name="Community Studio Low-Code Builder" 
              parent="menu_studio_lowcode_field_root" 
              action="action_studio_lowcode_field" 
              sequence="10"/>
</odoo>
