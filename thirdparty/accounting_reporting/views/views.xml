<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_accounting_report_hub_form" model="ir.ui.view">
        <field name="name">accounting.report.hub.form</field>
        <field name="model">accounting.report.hub</field>
        <field name="arch" type="xml">
            <form string="Community Accounting Reports Hub">
                <header>

                    <button name="action_calculate" string="Recalculate Ledger" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,calculated,audited"/>

                </header>
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Q4 Financial Performance Summary"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="report_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                            <field name="net_margin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Auditor Notes" name="notes">
                            <field name="notes" placeholder="Notes on ledger adjustments..."/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_accounting_report_hub_list" model="ir.ui.view">
        <field name="name">accounting.report.hub.list</field>
        <field name="model">accounting.report.hub</field>
        <field name="arch" type="xml">
            <list string="Community Accounting Reports Hub">

                <field name="name"/>
                <field name="report_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_debit"/>
                <field name="total_credit"/>
                <field name="net_margin"/>
                <field name="status" widget="badge"/>

            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_accounting_report_hub_search" model="ir.ui.view">
        <field name="name">accounting.report.hub.search</field>
        <field name="model">accounting.report.hub</field>
        <field name="arch" type="xml">
            <search string="Community Accounting Reports Hub">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_accounting_report_hub" model="ir.actions.act_window">
        <field name="name">Community Accounting Reports Hub</field>
        <field name="res_model">accounting.report.hub</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Community Accounting Reports Hub entry!
            </p>
        </field>
    </record>

    <!-- Top-level and Action Menu -->
    <menuitem id="menu_accounting_report_hub_root" 
              name="Community Accounting Reports Hub" 
              sequence="50"/>

    <menuitem id="menu_accounting_report_hub_main" 
              name="Community Accounting Reports Hub" 
              parent="menu_accounting_report_hub_root" 
              action="action_accounting_report_hub" 
              sequence="10"/>
</odoo>
