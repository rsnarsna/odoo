<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_payroll_wage_structure_form" model="ir.ui.view">
        <field name="name">payroll.wage.structure.form</field>
        <field name="model">payroll.wage.structure</field>
        <field name="arch" type="xml">
            <form string="Community Payroll and Wage Desk">
                <header>

                </header>
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="STD-ENG-2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="basic_wage"/>
                        </group>
                        <group>
                            <field name="housing_allowance"/>
                            <field name="transport_allowance"/>
                            <field name="tax_rate_pct"/>
                            <field name="net_payable"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_payroll_wage_structure_list" model="ir.ui.view">
        <field name="name">payroll.wage.structure.list</field>
        <field name="model">payroll.wage.structure</field>
        <field name="arch" type="xml">
            <list string="Community Payroll and Wage Desk">

                <field name="name"/>
                <field name="employee_id"/>
                <field name="basic_wage"/>
                <field name="housing_allowance"/>
                <field name="transport_allowance"/>
                <field name="net_payable"/>

            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_payroll_wage_structure_search" model="ir.ui.view">
        <field name="name">payroll.wage.structure.search</field>
        <field name="model">payroll.wage.structure</field>
        <field name="arch" type="xml">
            <search string="Community Payroll and Wage Desk">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_payroll_wage_structure" model="ir.actions.act_window">
        <field name="name">Community Payroll and Wage Desk</field>
        <field name="res_model">payroll.wage.structure</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Community Payroll and Wage Desk entry!
            </p>
        </field>
    </record>

    <!-- Top-level and Action Menu -->
    <menuitem id="menu_payroll_wage_structure_root" 
              name="Community Payroll and Wage Desk" 
              sequence="50"/>

    <menuitem id="menu_payroll_wage_structure_main" 
              name="Community Payroll and Wage Desk" 
              parent="menu_payroll_wage_structure_root" 
              action="action_payroll_wage_structure" 
              sequence="10"/>
</odoo>
