<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_fieldservice_custom_order_form" model="ir.ui.view">
        <field name="name">fieldservice.custom.order.form</field>
        <field name="model">fieldservice.custom.order</field>
        <field name="arch" type="xml">
            <form string="Field Service Dispatch Hub">
                <header>

                    <button name="action_assign" string="Dispatch Tech" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start" string="Mark On-Site" type="object" class="oe_highlight" invisible="state != 'assigned'"/>
                    <button name="action_complete" string="Complete Work" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,in_progress,completed"/>

                </header>
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="technician_id"/>
                            <field name="scheduled_date"/>
                        </group>
                        <group>
                            <field name="service_address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Work Summary" name="summary">
                            <field name="work_summary" placeholder="Details of work performed on customer site..."/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_fieldservice_custom_order_list" model="ir.ui.view">
        <field name="name">fieldservice.custom.order.list</field>
        <field name="model">fieldservice.custom.order</field>
        <field name="arch" type="xml">
            <list string="Field Service Dispatch Hub">

                <field name="name"/>
                <field name="partner_id"/>
                <field name="technician_id"/>
                <field name="scheduled_date"/>
                <field name="state" widget="badge"/>

            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_fieldservice_custom_order_search" model="ir.ui.view">
        <field name="name">fieldservice.custom.order.search</field>
        <field name="model">fieldservice.custom.order</field>
        <field name="arch" type="xml">
            <search string="Field Service Dispatch Hub">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_fieldservice_custom_order" model="ir.actions.act_window">
        <field name="name">Field Service Dispatch Hub</field>
        <field name="res_model">fieldservice.custom.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Field Service Dispatch Hub entry!
            </p>
        </field>
    </record>

    <!-- Top-level and Action Menu -->
    <menuitem id="menu_fieldservice_custom_order_root" 
              name="Field Service Dispatch Hub" 
              sequence="50"/>

    <menuitem id="menu_fieldservice_custom_order_main" 
              name="Field Service Dispatch Hub" 
              parent="menu_fieldservice_custom_order_root" 
              action="action_fieldservice_custom_order" 
              sequence="10"/>
</odoo>
