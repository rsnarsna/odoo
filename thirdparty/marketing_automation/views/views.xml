<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_marketing_automation_flow_form" model="ir.ui.view">
        <field name="name">marketing.automation.flow.form</field>
        <field name="model">marketing.automation.flow</field>
        <field name="arch" type="xml">
            <form string="Marketing Automation Engine">
                <header>

                    <button name="action_start" string="Start Campaign" type="object" class="oe_highlight" invisible="state == 'running'"/>
                    <button name="action_pause" string="Pause" type="object" invisible="state != 'running'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,paused"/>

                </header>
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Welcome Onboarding Drip Campaign"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="trigger_type"/>
                            <field name="delay_hours"/>
                        </group>
                        <group>
                            <field name="total_enrolled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Automated Email Template" name="body">
                            <field name="email_template" placeholder="Message content to dispatch..."/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_marketing_automation_flow_list" model="ir.ui.view">
        <field name="name">marketing.automation.flow.list</field>
        <field name="model">marketing.automation.flow</field>
        <field name="arch" type="xml">
            <list string="Marketing Automation Engine">

                <field name="name"/>
                <field name="trigger_type"/>
                <field name="delay_hours"/>
                <field name="total_enrolled"/>
                <field name="state" widget="badge"/>

            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_marketing_automation_flow_search" model="ir.ui.view">
        <field name="name">marketing.automation.flow.search</field>
        <field name="model">marketing.automation.flow</field>
        <field name="arch" type="xml">
            <search string="Marketing Automation Engine">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_marketing_automation_flow" model="ir.actions.act_window">
        <field name="name">Marketing Automation Engine</field>
        <field name="res_model">marketing.automation.flow</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Marketing Automation Engine entry!
            </p>
        </field>
    </record>

    <!-- Top-level and Action Menu -->
    <menuitem id="menu_marketing_automation_flow_root" 
              name="Marketing Automation Engine" 
              sequence="50"/>

    <menuitem id="menu_marketing_automation_flow_main" 
              name="Marketing Automation Engine" 
              parent="menu_marketing_automation_flow_root" 
              action="action_marketing_automation_flow" 
              sequence="10"/>
</odoo>
