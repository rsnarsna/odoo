# ==============================================================================
# Odoo & PostgreSQL Deployment Environment Configuration (Template)
# ==============================================================================
# Copy this file to .env and customize your credentials before deployment:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)

# Odoo Container Settings
ODOO_IMAGE_TAG=latest
ODOO_PORT=8069
ODOO_CHAT_PORT=8072

# Database Connection Settings
POSTGRES_VERSION=16
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_PORT=5432

# Master Password (for /web/database/manager)
ODOO_ADMIN_PASSWORD=change_this_master_admin_password

# Default ERP Admin Login Credentials
# Login URL: http://localhost:8069/web/login
ODOO_LOGIN=admin
ODOO_PASSWORD=admin
